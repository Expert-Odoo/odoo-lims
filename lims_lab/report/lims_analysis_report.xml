<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_lims_analysis_report" model="ir.actions.report">
        <field name="name">Analysis Sheet</field>
        <field name="model">lims.analysis</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lims_lab.report_lims_analysis_sheet</field>
        <field name="print_report_name">'Analysis_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_lims_analysis"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_lims_analysis_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>Analysis Sheet — <t t-esc="o.name"/></h3>
                        <hr/>
                        <div class="row">
                            <div class="col-6">
                                <strong>Sample:</strong> <t t-esc="o.sample_id.name"/><br/>
                                <strong>Parameter:</strong> <t t-esc="o.parameter_id.name"/><br/>
                                <strong>Method:</strong> <t t-esc="o.method_id.name or '-'"/><br/>
                                <strong>Analyst:</strong> <t t-esc="o.analyst_id.name or '-'"/>
                            </div>
                            <div class="col-6">
                                <strong>Start date:</strong>
                                <t t-esc="o.date_start.strftime('%Y-%m-%d %H:%M') if o.date_start else '-'"/><br/>
                                <strong>End date:</strong>
                                <t t-esc="o.date_end.strftime('%Y-%m-%d %H:%M') if o.date_end else '-'"/><br/>
                                <strong>Equipment:</strong> <t t-esc="o.equipment_id.name or '-'"/>
                            </div>
                        </div>
                        <h5 class="mt-3">Individual Measurements</h5>
                        <table class="table table-sm table-bordered">
                            <thead class="table-secondary">
                                <tr>
                                    <th>#</th>
                                    <th>Type</th>
                                    <th>Date/Time</th>
                                    <th>Raw Value</th>
                                    <th>Dilution Factor</th>
                                    <th>Corrected Value</th>
                                    <th>Outlier?</th>
                                    <th>Used</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.result_ids" t-as="r">
                                    <tr t-attf-class="#{r.is_outlier and 'table-danger' or ''}">
                                        <td><t t-esc="r_index + 1"/></td>
                                        <td><t t-esc="dict(r._fields['measurement_type'].selection).get(r.measurement_type,'')"/></td>
                                        <td><t t-esc="r.date_measurement.strftime('%Y-%m-%d %H:%M')"/></td>
                                        <td><t t-esc="'%.6g' % r.value"/></td>
                                        <td><t t-esc="r.dilution_factor"/></td>
                                        <td><t t-esc="'%.6g' % r.value_corrected"/></td>
                                        <td><t t-esc="'Yes' if r.is_outlier else 'No'"/></td>
                                        <td><t t-esc="'Yes' if r.is_used_for_result else 'No'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Final Result:</strong>
                                <t t-esc="'%.4g' % o.final_value if not o.is_qualitative else ''"/>
                                <t t-esc="o.final_value_char or ''"/>
                                <t t-esc="o.unit_id.symbol or ''"/>
                            </div>
                            <div class="col-6">
                                <strong>Conformity:</strong>
                                <t t-esc="dict(o._fields['conformity_state'].selection).get(o.conformity_state,'')"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
