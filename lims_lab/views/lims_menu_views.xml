    <menuitem id="menu_lims_settings_root"
              name="Configuration"
              parent="menu_lims_root"
              sequence="99"
              groups="lims_lab.group_lims_manager"/>

    <menuitem id="menu_lims_unit"
              name="Units of Measure"
              parent="menu_lims_settings_root"
              action="action_lims_unit"
