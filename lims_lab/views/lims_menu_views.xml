<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Root menu ─────────────────────────────────────────── -->
    <menuitem id="menu_lims_root"
              name="LIMS Laboratory"
              sequence="50"
              web_icon="lims_lab,static/description/icon.png"
              groups="lims_lab.group_lims_technician"/>

    <!-- ─── Dashboard ─────────────────────────────────────────── -->
    <menuitem id="menu_lims_dashboard"
