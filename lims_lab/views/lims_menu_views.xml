              parent="menu_lims_root"
              sequence="1"
              action="action_lims_sample"/>

    <!-- ─── Reception / Samples ───────────────────────────────── -->
    <menuitem id="menu_lims_reception"
              name="Reception"
              parent="menu_lims_root"
