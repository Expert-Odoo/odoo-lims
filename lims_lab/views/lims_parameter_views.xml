<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lims_parameter_form" model="ir.ui.view">
        <field name="name">lims.parameter.form</field>
        <field name="model">lims.parameter</field>
        <field name="arch" type="xml">
            <form string="Analysis Parameter">
                <sheet>
                    <widget name="web_ribbon" title="Accredited" bg_color="bg-success"
                            invisible="not is_accredited"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="code" placeholder="Short code"/></h3>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category_id"/>
                            <field name="unit_id"/>
                            <field name="method_ids" widget="many2many_tags"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Conformity Limits">
                            <field name="limit_min"/>
                            <field name="limit_max"/>
                            <field name="limit_unit_id"/>
                            <field name="lod"/>
                            <field name="loq"/>
                        </group>
                    </group>
                    <group>
                        <group string="Accreditation">
                            <field name="is_accredited" widget="boolean_toggle"/>
                            <field name="accreditation_scope" invisible="not is_accredited"/>
                        </group>
                        <group string="Invoicing">
                            <field name="product_id"/>
                            <field name="price" readonly="1"/>
                        </group>
                    </group>
                    <group string="Technical Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lims_parameter_list" model="ir.ui.view">
        <field name="name">lims.parameter.list</field>
        <field name="model">lims.parameter</field>
        <field name="arch" type="xml">
            <tree string="Parameters">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="unit_id"/>
                <field name="limit_min"/>
                <field name="limit_max"/>
                <field name="is_accredited" widget="boolean"/>
                <field name="product_id" optional="show"/>
                <field name="price" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_lims_parameter_search" model="ir.ui.view">
        <field name="name">lims.parameter.search</field>
        <field name="model">lims.parameter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <filter name="accredited" string="Accredited" domain="[('is_accredited','=',True)]"/>
                <filter name="with_product" string="With Billing Product"
                        domain="[('product_id','!=',False)]"/>
                <group>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lims_parameter" model="ir.actions.act_window">
        <field name="name">Analysis Parameters</field>
        <field name="res_model">lims.parameter</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_lims_parameter_search"/>
    </record>

    <!-- ─── Units ─────────────────────────────────────────────── -->
    <record id="view_lims_unit_list" model="ir.ui.view">
        <field name="name">lims.unit.list</field>
        <field name="model">lims.unit</field>
        <field name="arch" type="xml">
            <tree string="Units of Measure" editable="bottom">
                <field name="name"/>
                <field name="symbol"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="action_lims_unit" model="ir.actions.act_window">
        <field name="name">Units of Measure</field>
        <field name="res_model">lims.unit</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ─── Parameter Category ────────────────────────────────── -->
    <record id="view_lims_parameter_category_list" model="ir.ui.view">
        <field name="name">lims.parameter.category.list</field>
        <field name="model">lims.parameter.category</field>
        <field name="arch" type="xml">
            <tree string="Categories" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="parameter_count" string="Parameters Count" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="action_lims_parameter_category" model="ir.actions.act_window">
        <field name="name">Parameter Categories</field>
        <field name="res_model">lims.parameter.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
