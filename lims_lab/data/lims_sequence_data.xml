<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sample sequence -->
        <record id="seq_lims_sample" model="ir.sequence">
            <field name="name">LIMS Sample Sequence</field>
            <field name="code">lims.sample</field>
            <field name="prefix">SAMP/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Analysis sequence -->
        <record id="seq_lims_analysis" model="ir.sequence">
            <field name="name">LIMS Analysis Sequence</field>
            <field name="code">lims.analysis</field>
            <field name="prefix">ANA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Request sequence -->
        <record id="seq_lims_request" model="ir.sequence">
            <field name="name">LIMS Request Sequence</field>
            <field name="code">lims.request</field>
            <field name="prefix">REQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Non-conformity sequence -->
        <record id="seq_lims_nonconformity" model="ir.sequence">
            <field name="name">LIMS Non-Conformity Sequence</field>
            <field name="code">lims.nonconformity</field>
            <field name="prefix">NC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
